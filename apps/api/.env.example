# Copy to apps/api/.env (gitignored). See docs/05-operations/environment-setup.md.
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000
DATABASE_URL=file:./data/nextlevel.db
# 64 random bytes, base64: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=
ADMIN_EMAILS=admin@nextlevel.test
BILLING_ENABLED=false
# Local sign-in stub (personas admin, subscriber, suspended, outsider); never in production.
AUTH_STUB=1
# Real Google sign-in (leave AUTH_STUB unset):
# GOOGLE_CLIENT_ID_DESKTOP=
# GOOGLE_CLIENT_SECRET_DESKTOP=
# GOOGLE_CLIENT_ID_WEB=
# GOOGLE_CLIENT_SECRET_WEB=
# Admin console in development (Vite dev server):
ADMIN_ORIGIN=http://localhost:5174
