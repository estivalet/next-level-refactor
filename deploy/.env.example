# Copy to deploy/.env on the server (never commit the copy). Every variable is described in
# docs/05-operations/environment-setup.md.
NEXTLEVEL_VERSION=1.0.0-beta.1
NEXTLEVEL_DOMAIN=api.example.com

NODE_ENV=production
PUBLIC_URL=https://api.example.com
JWT_SECRET=
ADMIN_EMAILS=owner@example.com

GOOGLE_CLIENT_ID_DESKTOP=
GOOGLE_CLIENT_SECRET_DESKTOP=
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_SECRET_WEB=

# Billing stays off until the owner's Stripe check (D32, D58).
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Catalog files, art, evidence and the daily backups in Cloudflare R2 (D57).
FILE_STORE=s3
S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
S3_BUCKET=nextlevel-catalog
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
